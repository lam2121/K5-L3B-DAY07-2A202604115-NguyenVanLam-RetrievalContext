# Day 7 Environment Variables Configuration

# 1. Day 6 Vector Database Connection (pgvector Docker container)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# 2. Embedding Model (Phải đồng bộ với Day 6)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# 3. LLM API Key cho Agent Controller (Chọn 1 trong các nhà cung cấp)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. LLM Model Selection
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
FALLBACK_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
