# Day 7 Environment Variables Configuration

# 1. Day 6 Vector Database Connection (pgvector Docker container)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# 2. Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# 3. LLM API Key (Anthropic or OpenRouter)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. LLM Model
LLM_MODEL=claude-3-5-haiku-20241022
FALLBACK_LLM_MODEL=claude-3-haiku-20240307
